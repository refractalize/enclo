FROM fedora:44

ARG DEV_USER=developer
ARG DEV_UID=1000
RUN dnf install -y systemd openssh-server openssh-clients shadow-utils bash procps-ng sudo \
    && dnf clean all \
    && useradd --create-home --uid "${DEV_UID}" --shell /bin/bash --password '*' "${DEV_USER}" \
    && printf '%s ALL=(ALL) NOPASSWD: ALL\n' "${DEV_USER}" > /etc/sudoers.d/developer \
    && chmod 0440 /etc/sudoers.d/developer \
    && systemctl disable sshd.service \
    && rm -f /etc/ssh/ssh_host_*key*

# Enable systemd and choose masks in the container profile.
CMD ["/sbin/init"]
